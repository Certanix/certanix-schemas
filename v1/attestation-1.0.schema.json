{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "enum": [
            "entity-control",
            "data-eu-hosting",
            "evidence-eu-hosting",
            "compute-eu-siting",
            "bom-itar-free",
            "supply-chain-origin"
          ],
          "title": "Claim Id",
          "type": "string"
        },
        "class": {
          "enum": [
            "observed",
            "declared",
            "confirmed"
          ],
          "title": "Class",
          "type": "string"
        },
        "confirmations": {
          "items": {
            "$ref": "#/$defs/Confirmation"
          },
          "title": "Confirmations",
          "type": "array"
        },
        "declarations": {
          "items": {
            "$ref": "#/$defs/Declaration"
          },
          "title": "Declarations",
          "type": "array"
        },
        "legal_test": {
          "$ref": "#/$defs/LegalTest"
        },
        "named_tiers": {
          "items": {
            "type": "string"
          },
          "title": "Named Tiers",
          "type": "array"
        },
        "not_assessed_reason": {
          "anyOf": [
            {
              "enum": [
                "no-certanix-record",
                "record-carries-no-site",
                "record-signature-not-verified",
                "residency-unspecified",
                "supplier-did-not-disclose",
                "not-requested"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Not Assessed Reason"
        },
        "observed_records": {
          "items": {
            "$ref": "#/$defs/ObservedRecord"
          },
          "title": "Observed Records",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "holds",
            "does-not-hold",
            "outstanding",
            "not-assessed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "supplier_wording": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupplierWording"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "claim_id",
        "class",
        "legal_test",
        "outcome",
        "not_assessed_reason",
        "observed_records",
        "declarations",
        "confirmations",
        "named_tiers",
        "supplier_wording"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClassDefinitions": {
      "additionalProperties": false,
      "properties": {
        "confirmed": {
          "const": "confirmed by the named third party in a document recorded by digest; Certanix has not verified the confirmation",
          "title": "Confirmed",
          "type": "string"
        },
        "declared": {
          "const": "declared by the supplier; Certanix records the declaration, its document by digest, its signatory and whether it was sealed, and has not verified it",
          "title": "Declared",
          "type": "string"
        },
        "observed": {
          "const": "observed by Certanix in its own records; each record is named by digest and its own wording is quoted",
          "title": "Observed",
          "type": "string"
        }
      },
      "required": [
        "observed",
        "declared",
        "confirmed"
      ],
      "title": "ClassDefinitions",
      "type": "object"
    },
    "Confirmation": {
      "additionalProperties": false,
      "description": "A named third party's document by digest, and what kind of confirmation it is.",
      "properties": {
        "anchor_set_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Anchor Set Sha256"
        },
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Date",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "auditor",
            "notary",
            "member-state-guarantee",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "party": {
          "minLength": 1,
          "title": "Party",
          "type": "string"
        },
        "signature_reason": {
          "anyOf": [
            {
              "enum": [
                "embedded-in-pdf-not-checked",
                "no-anchor-in-pinned-set",
                "signature-does-not-verify"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Signature Reason"
        },
        "signature_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Signature Sha256"
        },
        "signature_status": {
          "enum": [
            "sealed",
            "signed-unverified",
            "unsigned"
          ],
          "title": "Signature Status",
          "type": "string"
        }
      },
      "required": [
        "party",
        "kind",
        "document_sha256",
        "media_type",
        "date",
        "signature_status",
        "signature_reason",
        "anchor_set_sha256",
        "signature_sha256"
      ],
      "title": "Confirmation",
      "type": "object"
    },
    "Declaration": {
      "additionalProperties": false,
      "description": "A supplier's declaration: the document by digest, who signed it, and its seal.",
      "properties": {
        "anchor_set_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Anchor Set Sha256"
        },
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Date",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "figures": {
          "items": {
            "$ref": "#/$defs/SupplierFigure"
          },
          "title": "Figures",
          "type": "array"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "signatory": {
          "$ref": "#/$defs/Signatory"
        },
        "signature_reason": {
          "anyOf": [
            {
              "enum": [
                "embedded-in-pdf-not-checked",
                "no-anchor-in-pinned-set",
                "signature-does-not-verify"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Signature Reason"
        },
        "signature_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Signature Sha256"
        },
        "signature_status": {
          "enum": [
            "sealed",
            "signed-unverified",
            "unsigned"
          ],
          "title": "Signature Status",
          "type": "string"
        },
        "tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tier"
        }
      },
      "required": [
        "document_sha256",
        "media_type",
        "signatory",
        "date",
        "signature_status",
        "signature_reason",
        "anchor_set_sha256",
        "signature_sha256",
        "tier",
        "figures"
      ],
      "title": "Declaration",
      "type": "object"
    },
    "LegalTableRef": {
      "additionalProperties": false,
      "description": "The legal table the claims' tests were copied from, by version and digest.",
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "table_version": {
          "minLength": 1,
          "title": "Table Version",
          "type": "string"
        }
      },
      "required": [
        "table_version",
        "sha256"
      ],
      "title": "LegalTableRef",
      "type": "object"
    },
    "LegalTest": {
      "additionalProperties": false,
      "description": "The test a claim was assessed against, copied from the legal table.",
      "properties": {
        "perimeter": {
          "minLength": 1,
          "title": "Perimeter",
          "type": "string"
        },
        "provision": {
          "minLength": 1,
          "title": "Provision",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "not reviewed by a lawyer",
            "reviewed by a lawyer"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reviewed By"
        },
        "test_id": {
          "minLength": 1,
          "title": "Test Id",
          "type": "string"
        },
        "test_version": {
          "minLength": 1,
          "title": "Test Version",
          "type": "string"
        }
      },
      "required": [
        "test_id",
        "test_version",
        "provision",
        "perimeter",
        "review_status",
        "reviewed_by"
      ],
      "title": "LegalTest",
      "type": "object"
    },
    "NotifyDuty": {
      "additionalProperties": false,
      "description": "The supplier's undertaking to notify a change of control or hosting.",
      "properties": {
        "basis": {
          "const": "as declared by the supplier",
          "title": "Basis",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "within_days": {
          "minimum": 1,
          "title": "Within Days",
          "type": "integer"
        }
      },
      "required": [
        "within_days",
        "document_sha256",
        "basis"
      ],
      "title": "NotifyDuty",
      "type": "object"
    },
    "ObservedRecord": {
      "additionalProperties": false,
      "description": "A Certanix record a claim was observed in, by digest, with its own wording.",
      "properties": {
        "kind": {
          "enum": [
            "vault-manifest",
            "tenant-file",
            "qpu-receipt",
            "cloud-record"
          ],
          "title": "Kind",
          "type": "string"
        },
        "record_wording": {
          "minLength": 1,
          "title": "Record Wording",
          "type": "string"
        },
        "recorded": {
          "additionalProperties": true,
          "title": "Recorded",
          "type": "object"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sha256",
        "recorded",
        "record_wording"
      ],
      "title": "ObservedRecord",
      "type": "object"
    },
    "PreviousAttestation": {
      "additionalProperties": false,
      "description": "The link to the attestation this one renews: the chain.",
      "properties": {
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "valid_from": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Valid From",
          "type": "string"
        }
      },
      "required": [
        "canonical_sha256",
        "valid_from"
      ],
      "title": "PreviousAttestation",
      "type": "object"
    },
    "ProductRef": {
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "identifier",
        "version"
      ],
      "title": "ProductRef",
      "type": "object"
    },
    "Registration": {
      "additionalProperties": false,
      "description": "One register entry, read as one: the number, the register that holds it, and that\nregister's country. As declared by the supplier.",
      "properties": {
        "register_country": {
          "pattern": "^[A-Z]{2}$",
          "title": "Register Country",
          "type": "string"
        },
        "register_name": {
          "minLength": 1,
          "title": "Register Name",
          "type": "string"
        },
        "registration_number": {
          "minLength": 1,
          "title": "Registration Number",
          "type": "string"
        }
      },
      "required": [
        "registration_number",
        "register_name",
        "register_country"
      ],
      "title": "Registration",
      "type": "object"
    },
    "Signatory": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "name",
        "role"
      ],
      "title": "Signatory",
      "type": "object"
    },
    "Signature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "default": "ECDSA-P256",
          "title": "Algorithm",
          "type": "string"
        },
        "key_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Source"
        },
        "signature_b64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature B64"
        }
      },
      "title": "Signature",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "properties": {
        "country_of_establishment": {
          "pattern": "^[A-Z]{2}$",
          "title": "Country Of Establishment",
          "type": "string"
        },
        "legal_name": {
          "minLength": 1,
          "title": "Legal Name",
          "type": "string"
        },
        "product": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProductRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "registration": {
          "$ref": "#/$defs/Registration"
        },
        "tender": {
          "anyOf": [
            {
              "$ref": "#/$defs/TenderReference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "legal_name",
        "registration",
        "country_of_establishment",
        "product",
        "tender"
      ],
      "title": "Subject",
      "type": "object"
    },
    "SupplierFigure": {
      "additionalProperties": false,
      "description": "A figure the supplier declares, such as a share of component cost.\n\nQuoted as declared. Certanix never computes or totals one.",
      "properties": {
        "basis": {
          "const": "as declared by the supplier",
          "title": "Basis",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value",
        "basis"
      ],
      "title": "SupplierFigure",
      "type": "object"
    },
    "SupplierWording": {
      "additionalProperties": false,
      "description": "The supplier's own words about a claim, quoted and labelled as such.",
      "properties": {
        "basis": {
          "const": "as declared by the supplier",
          "title": "Basis",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "basis"
      ],
      "title": "SupplierWording",
      "type": "object"
    },
    "TenderReference": {
      "additionalProperties": false,
      "description": "A tender or programme reference. The supplier's, never Certanix's.",
      "properties": {
        "basis": {
          "const": "as declared by the supplier",
          "title": "Basis",
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "basis"
      ],
      "title": "TenderReference",
      "type": "object"
    },
    "Validity": {
      "additionalProperties": false,
      "properties": {
        "valid_from": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "valid_from",
        "valid_until"
      ],
      "title": "Validity",
      "type": "object"
    }
  },
  "$id": "https://schema.certanix.eu/v1/attestation-1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A STANDALONE signed root with its own `schema_version` line — not a field of an evidence pack, so the pack schema does not move when this one does. FROZEN: a correction is a new version. Structural validity only.",
  "properties": {
    "artifact_type": {
      "const": "attestation",
      "default": "attestation",
      "title": "Artifact Type",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "class_definitions": {
      "$ref": "#/$defs/ClassDefinitions"
    },
    "framing": {
      "const": "An EU Control and Origin Attestation: a signed record of claims about one legal entity, the class of each claim, the legal test each was assessed against with that test's review status, and the documents behind each, by digest. Certanix signs this record as presented. It has not verified any declaration or confirmation it lists, and it does not verify ownership or origin. This record is not advice on the law, not a certificate, and not a finding that the entity meets any test or may take part in any tender. It expires on its valid_until date.",
      "title": "Framing",
      "type": "string"
    },
    "generated_at": {
      "minLength": 1,
      "title": "Generated At",
      "type": "string"
    },
    "legal_table": {
      "$ref": "#/$defs/LegalTableRef"
    },
    "notify_duty": {
      "anyOf": [
        {
          "$ref": "#/$defs/NotifyDuty"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_attestation": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreviousAttestation"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature": {
      "anyOf": [
        {
          "$ref": "#/$defs/Signature"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "validity": {
      "$ref": "#/$defs/Validity"
    }
  },
  "required": [
    "framing",
    "class_definitions",
    "subject",
    "legal_table",
    "claims",
    "validity",
    "notify_duty",
    "previous_attestation",
    "generated_at"
  ],
  "title": "Certanix attestation, schema 1.0",
  "type": "object"
}
