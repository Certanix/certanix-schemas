      },
      "title": "Signature",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "description": "What was certified: tenant, device manifest, and the AI policy under\ntest (§5.4 ``subject`` block).",
      "properties": {
        "ai_policy_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ai Policy Uri"
        },
        "device_manifest": {
          "title": "Device Manifest",
